+//===== eAthena Script ===========================================
+//= Fake Players (source-driven) — replaces the mob_avail generator
+//================================================================
+//= Requires the fakeplayer.c source feature (see INTEGRATION_PATCH.txt).
+//= These are REAL BL_PC units: player names (no HP bar), real vend shops,
+//= real overhead chat rooms, real movement & combat — driven server-side.
+//=
+//= Commands:
+//=   fakecity "<map>",<count>;                 // bulk populate (mixed roles)
+//=   fakeplayer "<name>",<class>,"<map>",<x>,<y>{,<flag>};  // returns GID
+//=        flag: 1 = wander, 2 = fight, 3 = wander+fight, 0 = stand still
+//=   fakevend <gid>,"<title>",<nameid>,<price>{,<nameid>,<price>,...};
+//=   fakechat <gid>,"<title>"{,<limit>};
+//=   fakeplayerremoveall {"<map>"};            // cleanup
+//================================================================
+
+-	script	FakePlayerController	-1,{
+	end;
+
+OnInit:
+	// --- Bulk city population (~80 each). Tune freely. -------------------
+	fakecity "prontera",80;
+	fakecity "morocc",80;
+	fakecity "payon",80;
+	fakecity "geffen",80;
+	fakecity "izlude",80;
+	fakecity "alberta",80;
+	fakecity "aldebaran",80;
+	fakecity "yuno",80;
+	fakecity "comodo",80;
+
+	// --- Hand-placed examples showing the granular commands -------------
+
+	// A Blacksmith standing in Prontera running a real vend shop:
+	.@v = fakeplayer("CheapSmith",JOB_BLACKSMITH,"prontera",152,180,0);
+	fakevend .@v,"S>+7 Gear & Ori",501,2500,985,180000,984,250000;
+
+	// A Wizard owning a real overhead party chat room:
+	.@c = fakeplayer("Need_HW",JOB_HIGH_WIZARD,"prontera",158,182,0);
+	fakechat .@c,"ET 1/12 LFP",12;
+
+	// A few players actually fighting on a field map (wander + fight):
+	fakeplayer "Hunter_A",JOB_HUNTER,"prt_fild08",170,180,3;
+	fakeplayer "Sniper_B",JOB_SNIPER,"prt_fild08",174,182,3;
+	fakeplayer "Assassin_C",JOB_ASSASSIN_CROSS,"prt_fild08",168,176,3;
+	end;
+}
+
+// Optional: a hidden GM-clickable to wipe & repopulate during testing.
+// Talk to it (warp a GM onto its cell) to reset Prontera's crowd.
+prontera,155,155,3	script	#FakeReset	-1,{
+	if( getgmlevel() < 60 ) end;
+	fakeplayerremoveall "prontera";
+	fakecity "prontera",80;
+	end;
+}
